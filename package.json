{
  "name": "word-tree",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "单词树1.0 — Word Tree: offline English vocabulary learning with word-family mind maps, etymology and IELTS vocabulary",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:data": "python3 scripts/verify_data.py",
    "build:mac": "python3 scripts/build_macos_app.py",
    "data:frequency": "python3 scripts/build_frequency.py"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "dagre": "^0.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.6"
  },
  "license": "MIT",
  "keywords": [
    "vocabulary",
    "word-family",
    "etymology",
    "mind-map",
    "ielts",
    "english-learning",
    "macos",
    "offline"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
